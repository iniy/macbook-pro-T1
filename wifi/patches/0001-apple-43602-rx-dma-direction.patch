+/*
+ * The BCM43602 firmware on Apple's 106b:0157 board reads posted RX
+ * buffers. Write-only IOMMU mappings cause DMA read faults and firmware
+ * command timeouts. Keep translation enabled and grant read access only
+ * to these driver-owned buffers; use the same direction when unmapping.
+ */
+static enum dma_data_direction
+brcmf_msgbuf_rx_direction(struct brcmf_bus *bus)
+{
+	struct pci_dev *pdev;
+
+	if (!dev_is_pci(bus->dev))
+		return DMA_FROM_DEVICE;
+
+	pdev = to_pci_dev(bus->dev);
+	if (pdev->vendor == PCI_VENDOR_ID_BROADCOM && pdev->device == 0x43ba &&
+	    pdev->subsystem_vendor == PCI_VENDOR_ID_APPLE &&
+	    pdev->subsystem_device == 0x0157 && pdev->revision == 2)
+		return DMA_BIDIRECTIONAL;
+
+	return DMA_FROM_DEVICE;
+}
+
