From: macbook-pro-T1 contributors
Subject: [PATCH] brcmfmac: optionally preserve India firmware country against AP hints

Inspired by Bogdan7c/macbook-bcm43602-wifi-fix at
35dd57c5b2b0fc8f76af5c6c2a45ead010692421 (ISC fixed_regdom.patch).
Unlike the reference's unconditional early return, keep user country requests
and cfg80211 channel/DFS/power handling intact. Only an already selected IN
firmware country on the exact tested Apple device can retain its table across
an AP COUNTRY_IE hint. Default off; no table/revision or RF values are invented.

SPDX-License-Identifier: ISC
--- a/brcmfmac/cfg80211.c
+++ b/brcmfmac/cfg80211.c
@@ -8,6 +8,7 @@
 #include <linux/kernel.h>
 #include <linux/etherdevice.h>
 #include <linux/module.h>
+#include <linux/pci.h>
 #include <linux/unaligned.h>
 #include <linux/vmalloc.h>
 #include <net/cfg80211.h>
@@ -8258,6 +8259,33 @@
 	return err;
 }
 
+static bool brcmf_fixed_regdom;
+module_param_named(fixed_regdom, brcmf_fixed_regdom, bool, 0644);
+MODULE_PARM_DESC(fixed_regdom,
+		 "Retain IN firmware country across AP hints on Apple BCM43602; honor user hints");
+
+static bool brcmf_keep_india_country(struct brcmf_pub *drvr,
+				   struct regulatory_request *req,
+				   struct brcmf_fil_country_le *country)
+{
+	struct device *dev = drvr->bus_if->dev;
+	struct pci_dev *pdev;
+
+	if (!brcmf_fixed_regdom ||
+	    req->initiator != NL80211_REGDOM_SET_BY_COUNTRY_IE ||
+	    !dev_is_pci(dev))
+		return false;
+
+	pdev = to_pci_dev(dev);
+	if (pdev->vendor != PCI_VENDOR_ID_BROADCOM || pdev->device != 0x43ba ||
+	    pdev->subsystem_vendor != PCI_VENDOR_ID_APPLE ||
+	    pdev->subsystem_device != 0x0157 || pdev->revision != 0x02)
+		return false;
+
+	return !memcmp(country->country_abbrev, "IN\0", 3) &&
+	       !memcmp(country->ccode, "IN\0", 3);
+}
+
 static void brcmf_cfg80211_reg_notifier(struct wiphy *wiphy,
 					struct regulatory_request *req)
 {
@@ -8289,6 +8317,13 @@
 		return;
 	}
 
+	/* cfg80211 has already applied host channel/DFS/power restrictions.
+	 * Keep the valid local firmware table without a reset-causing country
+	 * rewrite. Explicit user requests still take the ordinary path below.
+	 */
+	if (brcmf_keep_india_country(drvr, req, &ccreq))
+		return;
+
 	err = brcmf_translate_country_code(ifp->drvr, req->alpha2, &ccreq);
 	if (err)
 		return;
